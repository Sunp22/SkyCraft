+		template <class A>
+		void SetAV(A* a_values, RE::ActorValue a_av, float a_value)
+		{
+			if constexpr (requires { a_values->SetActorValue(a_av, a_value); }) {
+				a_values->SetActorValue(a_av, a_value);
