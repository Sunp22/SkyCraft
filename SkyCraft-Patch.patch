+						logger::info("Skyrim control: held the player on the ground (Skyrim had it in the air, {:.2f} s) on a block; state was {}, resting {}, feet {:.3f}, capsule bottom {:.3f}; plane hook: {} calls, {} planes (Skyrim's own {}, manifold {}), nearest {:.3f}, keepDistance {:.3f}",
+							airTime, int(controller->context.currentState), resting, end.y, boxZ, calls, planeCount, ownPlanes, manifold, nearest, keep);
+					}
+					controller->context.currentState = RE::hkpCharacterStateType::kOnGround;
+					if (airTime >= 0.10f) {
+						a_player->NotifyAnimationGraph("JumpLand");
+						a_player->NotifyAnimationGraph("JumpLandEnd");
+						static int announcedLand = 0;
+						if (announcedLand < 5) {
+							++announcedLand;
+							logger::info("Skyrim control: landed on a block by hand (Skyrim still had the player in the air)");
+						}
+					}
+				}
+				// Skyrim keeps putting the player back in the air (state 2) every step even though it is resting on a block, and an
+				// airborne player keeps its sideways speed: after a jump onto a block it slid across the top, and on to the next block, with
+				// nothing to stop it. With no movement key held the player stands still, as it would on the ground.
+				static bool wasAirborne = false;
+				const bool  flipped = controller->context.currentState != RE::hkpCharacterStateType::kOnGround || heldThisFrame;
+				if (flipped || wasAirborne) {
+					bool        known = false;
+					const float input = MoveInput(known);
+					if (known && input < 0.05f) {
+						StopMoving(controller);
+						static int announcedStop = 0;
+						if (announcedStop < 5) {
+							++announcedStop;
+							logger::info("Skyrim control: no movement key held on a block; stopped the player's leftover speed (slide)");
+						}
+					} else if (!known) {
+						static bool announcedUnknown = false;
+						if (!announcedUnknown) {
+							announcedUnknown = true;
+							logger::warn("Skyrim control: this build can't read the movement keys; the leftover speed on a block isn't stopped");
+						}
+					}
+				}
+				wasAirborne = flipped;
+				airTime = 0.0f;
+			}
+		}
 	}
 }
