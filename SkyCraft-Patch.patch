diff --git a/skse/SkyCraft.ini b/skse/SkyCraft.ini
index 92b585a..d588788 100644
--- a/skse/SkyCraft.ini
+++ b/skse/SkyCraft.ini
@@ -14,6 +14,49 @@ sLauncher =
 ; What to pass to your own launcher. For Prism: --launch and the SkyCraft instance's folder name.
 sArguments = --launch SkyCraft
 
+[Controls]
+; The key that switches between Minecraft's controls and Skyrim's own. In Skyrim's mode you move,
+; look, fight and use Skyrim's inventory, magic, shouts and perks as in plain Skyrim, with no
+; Minecraft HUD and no placed blocks drawn, and Minecraft's player just follows yours. Press the
+; key again to go back to Minecraft. SkyCraft keeps this key to itself in both modes, so pick one
+; Minecraft doesn't need.
+; A key name (F1-F12, Insert, Delete, Home, End, PageUp, PageDown, Pause, ScrollLock) or a
+; DirectInput scan code (66 or 0x42). Esc, ~, G, H, J, M, O and F9 are already used.
+sToggleKey = F8
+
+; 1 (the default): start every session, and every save you load, with Skyrim's controls (switch to
+; Minecraft's with the key above). Handy for playing through Skyrim's scripted opening, then switching
+; over. 0: start with Minecraft's controls.
+bStartInSkyrimMode = 1
+
+; Skyrim's mode: half the width, in blocks, of the box Minecraft's block collision holds your character to.
+; Minecraft's own player is 0.6 wide (0.3), but Skyrim's body is wider, so at 0.3 your head, shoulders
+; and arms sink into walls and block corners. Raise it if parts of you still poke into blocks; lower it
+; if you can't squeeze through one-block gaps. Between 0.3 and 0.49.
+fSkyrimBodyHalfWidth = 0.4
+
+; The key that resets the Minecraft world: every block you built or dug is removed, so nothing is left
+; floating where Skyrim has moved on (through a door, fast travel). Press it twice within 6 seconds to
+; confirm. Skyrim's controls take over for the few seconds it takes, then you're back where you were.
+; Your inventory and health stay. Same key names as sToggleKey, and it can't be the same key as that.
+; None switches it off.
+sResetKey = F7
+
+[Mobs]
+; Minecraft's mobs each have an invisible Skyrim actor (a stand-in) where they stand: it is what you lock on to, what Skyrim's
+; spells hit, and what Skyrim's NPCs fight. How it is kept out of sight:
+;   geometry  its body isn't drawn, but the actor is left showing, so lock-on mods still see it (default). A new stand-in is
+;             held at no alpha until its body has been found and hidden, so its spawn (the fade-in) is never seen
+;   root      the whole actor is culled (nothing else can see it either; lock-on may skip it)
+;   alpha     faded out
+;   none      shown (a skeever, scaled to the mob), to check where the stand-ins stand
+sStandInHide = geometry
+
+; The creature a stand-in is made from. Its sounds are the stand-in's sounds (the footsteps, growls and hurt cries are the creature's own), so
+; the default is a rabbit, which has no growls to make. A name of any creature in your game, or "Plugin.esp:0xFORMID" (the FormID without its
+; load-order byte) for an actor from a mod, e.g. a silent one you made. Stand-ins are never made from a skeever by default, nor from a creature that has spells or abilities of its own (the Wabbajack's rabbit does, which shows as a red mist).
+sStandInBase =
+
 [Debug]
 ; Detailed timing, camera, combat and lighting logs in SkyCraft.log (several lines a second), for
 ; reporting problems. 0 = off.
diff --git a/skse/src/BlockMove.h b/skse/src/BlockMove.h
new file mode 100644
index 0000000..0cbdd07
--- /dev/null
+++ b/skse/src/BlockMove.h
@@ -0,0 +1,158 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+// Minecraft's own movement collision (Entity.collide / collideBoundingBox / the step-up test),
+// on plain boxes and with no game types in it, so it is the same algorithm Minecraft runs and can
+// be tested on its own. Used to hold the Skyrim-controlled player against Minecraft's blocks 1:1.
+// Coordinates are Minecraft's (x east, y up, z south), in blocks. B is any box type with float or
+// double lo[3] and hi[3].
+namespace skycraft::BlockMove
+{
+	struct Aabb
+	{
+		double lo[3], hi[3];
+
+		Aabb Moved(double a_x, double a_y, double a_z) const
+		{
+			return { { lo[0] + a_x, lo[1] + a_y, lo[2] + a_z }, { hi[0] + a_x, hi[1] + a_y, hi[2] + a_z } };
+		}
+		// Minecraft's AABB.expandTowards: grows the box in the direction of the movement.
+		Aabb Expanded(double a_x, double a_y, double a_z) const
+		{
+			Aabb r = *this;
+			(a_x < 0 ? r.lo[0] : r.hi[0]) += a_x;
+			(a_y < 0 ? r.lo[1] : r.hi[1]) += a_y;
+			(a_z < 0 ? r.lo[2] : r.hi[2]) += a_z;
+			return r;
+		}
+	};
+
+	struct Vec
+	{
+		double x, y, z;
+		double HorizSqr() const { return x * x + z * z; }
+	};
+
+	constexpr double kEps = 1.0e-7;       // Shapes.collide's epsilon
+	constexpr double kStepHeight = 0.6;   // the player's maxUpStep
+
+	// Shapes.collide: how far the box can move along a_axis (by a_d) before a box stops it.
+	template <class B>
+	double ClipAxis(const std::vector<B>& a_boxes, const Aabb& a_a, int a_axis, double a_d)
+	{
+		const int o1 = (a_axis + 1) % 3, o2 = (a_axis + 2) % 3;
+		for (const auto& b : a_boxes) {
+			if (!(a_a.hi[o1] > b.lo[o1] + kEps && a_a.lo[o1] < b.hi[o1] - kEps && a_a.hi[o2] > b.lo[o2] + kEps && a_a.lo[o2] < b.hi[o2] - kEps)) {
+				continue;
+			}
+			if (a_d > 0.0 && b.lo[a_axis] >= a_a.hi[a_axis] - kEps) {
+				a_d = std::min(a_d, double(b.lo[a_axis]) - a_a.hi[a_axis]);
+			} else if (a_d < 0.0 && b.hi[a_axis] <= a_a.lo[a_axis] + kEps) {
+				a_d = std::max(a_d, double(b.hi[a_axis]) - a_a.lo[a_axis]);
+			}
+		}
+		return a_d;
+	}
+
+	// Entity.collideBoundingBox: y first, then whichever of x and z is the longer move first.
+	template <class B>
+	Vec CollideBox(const std::vector<B>& a_boxes, Aabb a_a, Vec a_m)
+	{
+		if (a_m.y != 0.0) {
+			a_m.y = ClipAxis(a_boxes, a_a, 1, a_m.y);
+			if (a_m.y != 0.0) {
+				a_a = a_a.Moved(0, a_m.y, 0);
+			}
+		}
+		const bool zFirst = std::abs(a_m.x) < std::abs(a_m.z);
+		if (zFirst && a_m.z != 0.0) {
+			a_m.z = ClipAxis(a_boxes, a_a, 2, a_m.z);
+			if (a_m.z != 0.0) {
+				a_a = a_a.Moved(0, 0, a_m.z);
+			}
+		}
+		if (a_m.x != 0.0) {
+			a_m.x = ClipAxis(a_boxes, a_a, 0, a_m.x);
+			if (!zFirst && a_m.x != 0.0) {
+				a_a = a_a.Moved(a_m.x, 0, 0);
+			}
+		}
+		if (!zFirst && a_m.z != 0.0) {
+			a_m.z = ClipAxis(a_boxes, a_a, 2, a_m.z);
+		}
+		return a_m;
+	}
+
+	// Entity.collide: the move the entity actually makes, with the step-up onto ledges of up to
+	// a_stepHeight when it was a_onGround (or lands this very move).
+	template <class B>
+	Vec Collide(const std::vector<B>& a_boxes, const Aabb& a_a, Vec a_m, bool a_onGround, double a_stepHeight = kStepHeight)
+	{
+		const Vec  c = CollideBox(a_boxes, a_a, a_m);
+		const bool xc = a_m.x != c.x, yc = a_m.y != c.y, zc = a_m.z != c.z;
+		const bool below = yc && a_m.y < 0.0;
+		if (a_stepHeight > 0.0 && (a_onGround || below) && (xc || zc)) {
+			Vec up = CollideBox(a_boxes, a_a, { a_m.x, a_stepHeight, a_m.z });
+			const Vec vert = CollideBox(a_boxes, a_a.Expanded(a_m.x, 0.0, a_m.z), { 0.0, a_stepHeight, 0.0 });
+			if (vert.y < a_stepHeight) {
+				Vec h = CollideBox(a_boxes, a_a.Moved(0, vert.y, 0), { a_m.x, 0.0, a_m.z });
+				h.y += vert.y;
+				if (h.HorizSqr() > up.HorizSqr()) {
+					up = h;
+				}
+			}
+			if (up.HorizSqr() > c.HorizSqr()) {
+				const Vec down = CollideBox(a_boxes, a_a.Moved(up.x, up.y, up.z), { 0.0, -up.y + a_m.y, 0.0 });
+				return { up.x + down.x, up.y + down.y, up.z + down.z };
+			}
+		}
+		return c;
+	}
+
+	// Pushes a box that ended up inside blocks (a block placed on it, a teleport) back out the
+	// shortest way, up first when the ledge is within a step. Returns how far it moved.
+	template <class B>
+	Vec Depenetrate(const std::vector<B>& a_boxes, Aabb a_a, double a_stepHeight = kStepHeight)
+	{
+		Vec total{ 0, 0, 0 };
+		for (int pass = 0; pass < 6; ++pass) {
+			bool hit = false;
+			for (const auto& b : a_boxes) {
+				bool in = true;
+				for (int i = 0; i < 3; ++i) {
+					in = in && a_a.hi[i] > b.lo[i] + 1e-4 && a_a.lo[i] < b.hi[i] - 1e-4;
+				}
+				if (!in) {
+					continue;
+				}
+				const double up = b.hi[1] - a_a.lo[1];
+				double       best = 1e9;
+				Vec          move{ 0, 0, 0 };
+				if (up <= a_stepHeight + 0.05) {
+					best = up;
+					move = { 0, up, 0 };
+				} else {
+					const double d[4] = { b.hi[0] - a_a.lo[0], a_a.hi[0] - b.lo[0], b.hi[2] - a_a.lo[2], a_a.hi[2] - b.lo[2] };
+					const Vec    v[4] = { { d[0], 0, 0 }, { -d[1], 0, 0 }, { 0, 0, d[2] }, { 0, 0, -d[3] } };
+					for (int i = 0; i < 4; ++i) {
+						if (d[i] < best) {
+							best = d[i];
+							move = v[i];
+						}
+					}
+				}
+				a_a = a_a.Moved(move.x, move.y, move.z);
+				total = { total.x + move.x, total.y + move.y, total.z + move.z };
+				hit = true;
+				break;
+			}
+			if (!hit) {
+				break;
+			}
+		}
+		return total;
+	}
+}
