+		}
+		try (FileChannel channel = FileChannel.open(lock, StandardOpenOption.WRITE); FileLock held = channel.tryLock()) {
+			return held != null;
+		} catch (OverlappingFileLockException | IOException e) {
+			return false;
+		}
+	}
